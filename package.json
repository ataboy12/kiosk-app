{
  "name": "kiosk-dsn",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @kiosk/web dev",
    "build": "pnpm --filter @kiosk/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @kiosk/db migrate",
    "db:seed": "pnpm --filter @kiosk/db seed",
    "db:reset": "pnpm --filter @kiosk/db reset",
    "db:generate": "pnpm --filter @kiosk/db db:generate",
    "bootstrap": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:studio": "pnpm --filter @kiosk/db studio"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  }
}
