{
  "name": "@kiosk/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations, question seed and shared client.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "seed": "dotenv -e ../../.env -- tsx src/seed/run.ts",
    "reset": "dotenv -e ../../.env -- tsx src/scripts/reset.ts && pnpm migrate && pnpm seed",
    "studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kiosk/eslint-config": "workspace:*",
    "@kiosk/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dotenv-cli": "11.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
